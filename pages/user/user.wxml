<!--pages/user/user.wxml-->
<view class="container">
  <!-- 用户信息 -->
  <view class="user-info card">
    <view class="user-avatar">
      <image wx:if="{{userInfo.avatarUrl}}" src="{{userInfo.avatarUrl}}" class="avatar"></image>
      <view wx:else class="avatar-default"><image class="avatar-default-img" src="/images/user.png" mode="aspectFit"></image></view>
    </view>
    <view class="user-details">
      <view class="user-name">{{userInfo.nickName || '微信用户'}}</view>
      <view class="user-stats">
        <text>已收藏 {{userStats.favoriteDishes}} 道菜品</text>
        <text>·</text>
        <text>已记录 {{userStats.totalRecords}} 次用餐</text>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="navigateTo" data-url="/pages/statistics/statistics">
      <view class="menu-left">
        <text class="menu-text">饮食统计</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="navigateTo" data-url="/pages/settings/settings">
      <view class="menu-left">
        <text class="menu-text">设置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="quick-actions">
    <view class="action-btn" bindtap="clearCache">
      <text class="action-text">清除缓存</text>
    </view>

    <view class="action-btn" bindtap="contactSupport">
      <text class="action-text">联系支持</text>
    </view>

    <view class="action-btn" bindtap="shareApp">
      <text class="action-text">分享小程序</text>
    </view>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>版本号：{{version}}</text>
    <text wx:if="{{hasUpdate}}" class="update-badge" bindtap="checkUpdate">有新版本</text>
  </view>

  <!-- 开发者信息 -->
  <view class="developer-info">
    <text>© 2024 今日吃啥 · 让饮食更简单</text>
  </view>
</view>