/* ==================== 菜品详情页 - 有机自然美食风 v2.0 ==================== */

.dish-swiper {
  height: 440rpx;
  border-radius: 0 0 var(--radius-xl) var(--radius-xl);
  overflow: hidden;
  margin: 0 -28rpx;
  width: calc(100% + 56rpx);
  box-shadow: var(--shadow-md);
}

.dish-image {
  width: 100%;
  height: 100%;
  display: block;
}

.dish-info {
  margin-top: -20rpx;
  padding: 36rpx 32rpx;
  position: relative;
  z-index: 2;
  border-radius: var(--radius-xl);
}

.dish-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 2rpx solid var(--color-divider);
}

.dish-name {
  font-size: var(--font-size-xxl);
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.3;
  flex: 1;
  margin-right: 20rpx;
  font-family: 'Georgia', 'PingFang SC', serif;
}

.star-rating {
  flex-shrink: 0;
  display: flex;
  gap: 4rpx;
}

.star {
  font-size: 32rpx;
  letter-spacing: 2rpx;
}

.star-filled {
  color: var(--color-primary);
}

.star-empty {
  color: var(--color-divider);
}

.dish-description {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: #FDF5EF;
  border-radius: var(--radius-lg);
  border-left: 4rpx solid var(--color-primary-light);
  position: relative;
}

.dish-meta {
  margin-bottom: 32rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
}

.meta-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  flex-shrink: 0;
  opacity: 0.7;
}

.ingredients-section {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid var(--color-divider);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
  font-family: 'Georgia', serif;
}

.ingredients-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.ingredient-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ingredient-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.action-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 40rpx;
  padding: 0 0 calc(40rpx + constant(safe-area-inset-bottom));
  padding: 0 0 calc(40rpx + env(safe-area-inset-bottom));
}

.action-buttons .btn-secondary:last-child {
  grid-column: 1 / -1;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 删除确认弹窗 */
.delete-dialog {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.dialog-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-mask);
  animation: fadeIn 0.2s ease;
}

.dialog-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 48rpx;
  width: 82%;
  max-width: 600rpx;
  box-shadow: var(--shadow-lg);
  animation: fadeIn 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.dialog-title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  color: var(--color-text-primary);
}

.dialog-message {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 44rpx;
  line-height: 1.6;
}

.dialog-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

/* 响应式调整 */
@media (min-width: 768px) {
  .dish-swiper {
    height: 520rpx;
  }

  .dish-info {
    padding: 44rpx;
  }

  .action-buttons {
    grid-template-columns: repeat(3, 1fr);
    max-width: 600rpx;
    margin: 48rpx auto;
  }
  
  .action-buttons .btn-secondary:last-child {
    grid-column: auto;
  }
}