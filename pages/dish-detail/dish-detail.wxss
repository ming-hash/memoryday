/* ==================== 菜品详情页 - 温暖水彩美食风 ==================== */

.dish-swiper {
  height: 420rpx;
}

.dish-image {
  width: 100%;
  height: 100%;
  display: block;
}

.dish-info {
  padding: 32rpx;
}

.dish-header {
  margin-bottom: 24rpx;
}

.dish-name {
  font-size: var(--font-size-xxl);
  font-weight: 700;
  color: var(--color-text-primary);
  line-height: 1.3;
}

.star-rating {
  color: var(--color-primary);
  font-size: var(--font-size-base);
  letter-spacing: 3rpx;
  margin-top: 10rpx;
}

.dish-description {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.7;
  margin-bottom: 32rpx;
  padding: 24rpx;
  background: #FFFAF5;
  border-radius: var(--radius-lg);
  border-left: 4rpx solid var(--color-primary-light);
}

.dish-meta {
  margin-bottom: 32rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
}

.meta-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
  opacity: 0.65;
  display: inline-block;
}

.ingredients-section {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid var(--color-divider);
}

.section-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
}

.ingredients-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.action-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 20rpx;
  margin-top: 48rpx;
  padding: 0 20rpx;
}

.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

/* 删除确认弹窗 */
.delete-dialog {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
}

.dialog-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-mask);
}

.dialog-content {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 48rpx;
  width: 82%;
  max-width: 600rpx;
  box-shadow: var(--shadow-lg);
}

.dialog-title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
  color: var(--color-text-primary);
}

.dialog-message {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 44rpx;
  line-height: 1.6;
}

.dialog-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

/* 响应式调整 */
@media (min-width: 768px) {
  .dish-swiper {
    height: 520rpx;
  }

  .dish-info {
    padding: 44rpx;
  }

  .action-buttons {
    grid-template-columns: repeat(3, 1fr);
    max-width: 600rpx;
    margin: 48rpx auto;
  }
}
