<!--pages/dish-detail/dish-detail.wxml-->
<view class="container">
  <!-- 图片轮播 -->
  <swiper class="dish-swiper" indicator-dots="{{dish.images.length > 1}}" autoplay="{{dish.images.length > 1}}">
    <block wx:for="{{dish.images}}" wx:key="index">
      <swiper-item>
        <image class="dish-image" src="{{item}}" mode="aspectFill"></image>
      </swiper-item>
    </block>
  </swiper>

  <!-- 菜品基本信息 -->
  <view class="dish-info card">
    <view class="dish-header flex-between">
      <view class="dish-name">{{dish.name}}</view>
      <view class="star-rating">
        <text wx:for="{{[1,2,3,4,5]}}" wx:key="index">
          {{index < dish.starRating ? '★' : '☆'}}
        </text>
      </view>
    </view>

    <view class="dish-description" wx:if="{{dish.description}}">
      {{dish.description}}
    </view>

    <!-- 标签信息 -->
    <view class="dish-meta">
      <view class="meta-item">
        <text class="meta-icon">⏱️</text>
        <text>烹饪时间：{{dish.cookingTime}}</text>
      </view>
      
      <view class="meta-item">
        <text class="meta-icon">🏆</text>
        <text>难度：{{dish.difficulty}}</text>
      </view>

      <view class="meta-item">
        <text class="meta-icon">🍳</text>
        <text>菜系：{{dish.cuisineType}}</text>
      </view>

      <view class="meta-item" wx:if="{{dish.mealTime.length > 0}}">
        <text class="meta-icon">🍴</text>
        <text>用餐场景：{{mealTimeLabels}}</text>
      </view>
    </view>

    <!-- 食材标签 -->
    <view class="ingredients-section" wx:if="{{dish.ingredients.length > 0}}">
      <view class="section-title">食材</view>
      <view class="ingredients-tags">
        <view class="tag tag-primary" wx:for="{{dish.ingredients}}" wx:key="index">
          {{item}}
        </view>
      </view>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="btn-secondary btn-medium" bindtap="editDish">编辑</button>
    <button class="btn-primary btn-medium" bindtap="randomThisType">同类随机</button>
    <button class="btn-primary btn-medium share-btn" open-type="share">
      <text class="btn-icon">📤</text>
      分享
    </button>
  </view>

  <!-- 删除确认弹窗 -->
  <view class="delete-dialog" wx:if="{{showDeleteDialog}}">
    <view class="dialog-mask" bindtap="hideDeleteDialog"></view>
    <view class="dialog-content">
      <view class="dialog-title">确认删除</view>
      <view class="dialog-message">确定要删除"{{dish.name}}"吗？此操作不可恢复。</view>
      <view class="dialog-buttons">
        <button class="btn-secondary" bindtap="hideDeleteDialog">取消</button>
        <button class="btn-primary" bindtap="confirmDelete">确认删除</button>
      </view>
    </view>
  </view>
</view>