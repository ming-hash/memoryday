/* 未登录提示 */
.login-prompt {
  text-align: center;
  padding: 80rpx 40rpx;
  margin: 32rpx 24rpx;
}

.login-icon-box {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  box-shadow: var(--shadow-warm);
}

.login-icon-text {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  font-family: Georgia, 'Times New Roman', serif;
}

.login-text {
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  margin-bottom: 32rpx;
}

.login-btn {
  background: var(--color-primary-gradient);
  color: #FFFFFF;
  border-radius: var(--radius-capsule);
  padding: 16rpx 48rpx;
  font-size: var(--font-size-md);
  border: none;
  display: inline-block;
}

/* ==================== 统计页 - 温暖水彩美食风 ==================== */

.page-container {
  background: var(--color-bg-page);
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.stats-overview {
  padding: 32rpx 24rpx;
}

.stats-title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 32rpx;
  text-align: center;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.stat-item {
  text-align: center;
  padding: 32rpx 16rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #FDF8F3 100%);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(212, 115, 94, 0.08);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
}

.stat-item:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-md);
}

.stat-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: var(--color-primary-gradient);
  opacity: 0.6;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

/* 本周最爱 */
.top-dishes {
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.top-dish-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.dish-thumb {
  width: 84rpx;
  height: 84rpx;
  border-radius: var(--radius-md);
  margin-right: 20rpx;
  object-fit: cover;
}

.dish-info {
  flex: 1;
}

.dish-name {
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 6rpx;
}

.dish-count {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.dish-rank {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-primary);
  min-width: 64rpx;
  text-align: center;
  opacity: 0.85;
}

/* 图表容器 */
.chart-container {
  height: 320rpx;
  margin-bottom: 30rpx;
  padding: 0 24rpx;
}

.chart {
  width: 100%;
  height: 100%;
}

.chart-legend {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  padding: 0 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.legend-color {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.legend-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-right: 8rpx;
  flex: 1;
}

.legend-value {
  font-size: var(--font-size-sm);
  font-weight: 600;
  color: var(--color-text-primary);
}

/* 用餐场景统计 */
.meal-time-stats {
  margin-top: 24rpx;
  padding: 0 24rpx;
}

.meal-time-item {
  margin-bottom: 28rpx;
}

.meal-time-label {
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  margin-bottom: 10rpx;
  font-weight: 500;
}

.progress-bar {
  height: 22rpx;
  background: var(--color-divider);
  border-radius: 11rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-fill {
  height: 100%;
  border-radius: 11rpx;
  background: var(--color-primary-gradient);
  transition: width 0.4s ease;
  position: relative;
}

.progress-fill::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(255, 255, 255, 0.2) 50%,
    transparent 100%
  );
}

.meal-time-value {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  text-align: right;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon-box {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24rpx;
  box-shadow: var(--shadow-warm);
}

.empty-icon-text {
  font-size: 56rpx;
  font-weight: 700;
  color: #fff;
  font-family: Georgia, 'Times New Roman', serif;
}

.empty-text {
  font-size: var(--font-size-md);
  color: var(--color-text-tertiary);
}

/* 更新时间 */
.update-time {
  text-align: center;
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
  margin: 48rpx 0 32rpx;
  padding: 20rpx;
}

.update-badge {
  display: inline-block;
  background: #FAEEE8;
  color: var(--color-primary);
  padding: 4rpx 14rpx;
  border-radius: var(--radius-capsule);
  font-size: var(--font-size-xs);
  margin-left: 8rpx;
}

/* 响应式调整 */
@media (min-width: 768px) {
  .stats-grid {
    gap: 28rpx;
  }

  .stat-item {
    padding: 40rpx 28rpx;
  }

  .stat-value {
    font-size: 52rpx;
  }

  .chart-legend {
    grid-template-columns: repeat(3, 1fr);
  }
}
