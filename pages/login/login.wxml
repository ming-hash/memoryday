<view class="login-container">
  <view class="login-header">
    <view class="logo-box"><text class="logo-text">M</text></view>
    <text class="app-name">今日吃啥</text>
    <text class="app-desc">发现美食，记录生活</text>
  </view>

  <view class="login-content">
    <view class="login-card">
      <text class="welcome-title">欢迎回来</text>
      <text class="welcome-desc">一键微信登录，开启美食之旅</text>

      <button
        class="wechat-login-btn"
        bindtap="onWechatLogin"
        disabled="{{isLoggingIn}}"
        loading="{{isLoggingIn}}"
      >
        <image
          class="wechat-icon"
          src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23FFFFFF'%3E%3Cpath d='M8.5 11.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm7 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2zm-3.5 7c-1.5 0-2.9-.3-4.2-.8l-3.2 1.3.8-2.8C3.9 15.3 3 13.7 3 12c0-4.4 4-8 9-8s9 3.6 9 8-4 8-9 8z'/%3E%3C/svg%3E"
          mode="aspectFit"
        />
        <text>微信一键登录</text>
      </button>

      <view class="agreement">
        <checkbox
          class="agreement-checkbox"
          checked="{{agreed}}"
          bindtap="onAgreementChange"
        />
        <text class="agreement-text">
          我已阅读并同意
          <text class="agreement-link" bindtap="onShowAgreement">《用户协议》</text>
          和
          <text class="agreement-link" bindtap="onShowPrivacy">《隐私政策》</text>
        </text>
      </view>
    </view>
  </view>

  <view class="login-footer">
    <text class="footer-text">
      登录即表示您同意我们的服务条款
    </text>
  </view>
</view>