/* ==================== 登录页 - 微信原生登录 ==================== */

.login-container {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 20% 10%, rgba(212, 115, 94, 0.25) 0%, transparent 55%),
    radial-gradient(ellipse at 80% 30%, rgba(232, 153, 122, 0.15) 0%, transparent 45%),
    radial-gradient(ellipse at 40% 85%, rgba(232, 168, 124, 0.2) 0%, transparent 50%),
    linear-gradient(155deg, #D4735E 0%, #C06852 35%, #B85A48 70%, #A04E3E 100%);
  padding: 60rpx 40rpx calc(40rpx + constant(safe-area-inset-bottom));
  padding: 60rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.login-header {
  text-align: center;
  padding-top: 80rpx;
}

.logo-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  height: 130rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.logo-text {
  font-size: 60rpx;
  font-weight: 700;
  color: #fff;
  font-family: Georgia, 'Times New Roman', serif;
}

.app-name {
  display: block;
  font-size: 50rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.app-desc {
  display: block;
  font-size: var(--font-size-base);
  color: rgba(255, 255, 255, 0.85);
}

.login-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 16rpx;
}

.login-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 60rpx 44rpx;
  box-shadow: 0 16rpx 56rpx rgba(139, 77, 42, 0.15);
  text-align: center;
}

.welcome-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #3D2B1F;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.welcome-desc {
  display: block;
  font-size: var(--font-size-base);
  color: #8B7D72;
  margin-bottom: 56rpx;
  line-height: 1.5;
}

.wechat-login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: #07C160;
  color: #fff;
  font-size: var(--font-size-xl);
  font-weight: 600;
  border-radius: 50rpx;
  border: none !important;
  letter-spacing: 2rpx;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  transition: all 0.2s ease;
}

.wechat-login-btn::after {
  display: none;
}

.wechat-login-btn:active {
  transform: scale(0.97);
  box-shadow: 0 4rpx 12rpx rgba(7, 193, 96, 0.25);
}

.wechat-login-btn[disabled] {
  background: #a8e6c0;
  box-shadow: none;
}

.wechat-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  margin-top: 40rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.agreement-checkbox {
  transform: scale(0.8);
}

.agreement-link {
  color: var(--color-primary);
  font-weight: 500;
}

.login-footer {
  text-align: center;
  padding-bottom: 20rpx;
}

.footer-text {
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.6);
  letter-spacing: 1rpx;
}