/* ==================== 登录页 - 温暖水彩美食风 ==================== */

.login-container {
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 20% 10%, rgba(212, 115, 94, 0.25) 0%, transparent 55%),
    radial-gradient(ellipse at 80% 30%, rgba(232, 153, 122, 0.15) 0%, transparent 45%),
    radial-gradient(ellipse at 40% 85%, rgba(232, 168, 124, 0.2) 0%, transparent 50%),
    linear-gradient(155deg, #D4735E 0%, #C06852 35%, #B85A48 70%, #A04E3E 100%);
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.login-header {
  text-align: center;
  margin-bottom: 64rpx;
  padding-top: 40rpx;
}

.logo-box {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  height: 130rpx;
  margin: 0 auto 32rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10px);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
}

.logo-text {
  font-size: 60rpx;
  font-weight: 700;
  color: #fff;
  font-family: Georgia, 'Times New Roman', serif;
}

.app-name {
  display: block;
  font-size: 50rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
  letter-spacing: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.app-desc {
  display: block;
  font-size: var(--font-size-base);
  color: rgba(255, 255, 255, 0.85);
}

.login-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.login-form {
  background: var(--color-bg-card);
  border-radius: 28rpx;
  padding: 56rpx 40rpx;
  box-shadow: 0 12rpx 48rpx rgba(139, 77, 42, 0.12);
}

.form-group {
  margin-bottom: 36rpx;
}

.label {
  display: block;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  margin-bottom: 18rpx;
  font-weight: 600;
}

.input {
  border: 2rpx solid var(--color-divider);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: var(--font-size-base);
  background: #FFFBF7;
  color: var(--color-text-primary);
  transition: all 0.2s ease;
}

.input:focus {
  border-color: var(--color-primary);
  background: var(--color-bg-card);
  outline: none;
}

.code-input-group {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.send-code-btn {
  padding: 0 28rpx;
  height: 84rpx;
  line-height: 84rpx;
  background: var(--color-primary-gradient);
  color: #fff;
  border-radius: var(--radius-md);
  font-size: var(--font-size-sm);
  min-width: 176rpx;
  font-weight: 500;
  border: none;
}

.send-code-btn[disabled] {
  background: var(--color-divider);
  color: var(--color-text-placeholder);
}

.login-btn {
  background: var(--color-primary-gradient);
  color: #fff;
  border-radius: var(--radius-capsule);
  height: 92rpx;
  line-height: 92rpx;
  font-size: var(--font-size-xl);
  margin: 44rpx 0 28rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  border: none !important;
}

.login-btn::after {
  display: none;
}

.login-btn[disabled] {
  background: var(--color-divider);
}

.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.agreement-checkbox {
  transform: scale(0.85);
}

.agreement-link {
  color: var(--color-primary);
  font-weight: 500;
}

.login-footer {
  text-align: center;
  margin-top: 56rpx;
}

.footer-text {
  display: block;
  font-size: var(--font-size-sm);
  color: rgba(255, 255, 255, 0.75);
  margin-bottom: 28rpx;
}

.other-login-methods {
  display: flex;
  justify-content: center;
}

.wechat-login-btn {
  background: transparent;
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: var(--radius-capsule);
  padding: 20rpx 44rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  color: #fff;
  font-size: var(--font-size-md);
  transition: all 0.2s ease;
}

.wechat-login-btn:active {
  background: rgba(255, 255, 255, 0.1);
}

.wechat-icon-box {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
}

.wechat-icon-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  font-family: Georgia, 'Times New Roman', serif;
}
