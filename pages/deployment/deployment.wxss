/* pages/deployment/deployment.wxss - 有机自然美食风 */

.deployment-page {
  padding: 24rpx 28rpx;
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* 当前配置样式 */
.current-config {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: var(--shadow-sm);
}

.config-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.config-header .title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--color-text-primary);
}

.mode-tag {
  padding: 6rpx 18rpx;
  border-radius: 24rpx;
  font-size: var(--font-size-xs);
  font-weight: 500;
}

.mode-tag.local-dev {
  background: #EDF0F8;
  color: #5A7AE8;
  border: 1rpx solid #C8D4F5;
}

.mode-tag.local {
  background: #EDF5EE;
  color: var(--color-success);
  border: 1rpx solid #C8E0CC;
}

.mode-tag.cloudbase {
  background: #FDF3E8;
  color: var(--color-warning);
  border: 1rpx solid #F5E0C8;
}

.config-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--color-divider);
}

.config-item:last-child {
  border-bottom: none;
}

.config-item .label {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  min-width: 200rpx;
}

.config-item .value {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  font-family: 'Courier New', monospace;
  word-break: break-all;
}

/* 部署选项样式 */
.deployment-options {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 32rpx;
  margin-bottom: 28rpx;
  box-shadow: var(--shadow-sm);
}

.section-title {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 28rpx;
  display: block;
}

.option-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 28rpx;
  transition: all 0.3s ease;
  position: relative;
}

.option-item.active {
  border-color: var(--color-primary);
  background: #FAEEE8;
}

.option-item.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.option-item:active {
  border-color: var(--color-primary-light);
  background: #F5EDE8;
}

.option-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.option-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.option-title text:first-child {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
}

.badge {
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
  font-size: var(--font-size-xs);
  font-weight: 500;
}

.badge.local-dev {
  background: #EDF0F8;
  color: #5A7AE8;
}

.badge.local {
  background: #EDF5EE;
  color: var(--color-success);
}

.badge.cloudbase {
  background: #FDF3E8;
  color: var(--color-warning);
}

.option-status .current {
  color: var(--color-success);
  font-size: var(--font-size-sm);
  font-weight: 500;
}

.option-status .disabled-text {
  color: var(--color-danger);
  font-size: var(--font-size-sm);
}

.option-description {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.option-details .api-url {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  font-family: 'Courier New', monospace;
  word-break: break-all;
}

/* 操作按钮样式 */
.action-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.btn {
  flex: 1;
  height: 80rpx;
  border-radius: var(--radius-capsule);
  font-size: var(--font-size-base);
  font-weight: 500;
  border: none;
  transition: all 0.2s ease;
}

.btn:active {
  transform: scale(0.97);
}

.btn::after {
  display: none;
}

.test-btn {
  background: var(--color-primary-gradient);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(212, 115, 94, 0.25);
}

.guide-btn {
  background: var(--color-bg-card);
  color: var(--color-text-primary);
  border: 2rpx solid var(--color-border) !important;
}

.copy-btn {
  background: var(--color-bg-card);
  color: var(--color-text-primary);
  border: 2rpx solid var(--color-border) !important;
}

/* 部署说明样式 */
.deployment-info {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.info-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
  display: block;
}

.info-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-item {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.5;
}