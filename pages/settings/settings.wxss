/* ==================== 设置页 - 温暖水彩美食风 ==================== */

.settings-container {
  min-height: 100vh;
  background: var(--color-bg-page);
  padding: 20rpx;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.user-section {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  padding: 40rpx;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 30rpx;
  box-shadow: var(--shadow-sm);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-primary-gradient);
  box-shadow: var(--shadow-sm);
}

.user-avatar-default {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: var(--color-primary-gradient);
  box-shadow: var(--shadow-sm);
}

.avatar-default-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  font-family: Georgia, 'Times New Roman', serif;
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: var(--font-size-xxl);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 10rpx;
}

.user-phone {
  display: block;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.user-desc {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
}

.settings-list {
  margin-bottom: 40rpx;
}

.settings-group {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  margin-bottom: 28rpx;
  overflow: hidden;
  box-shadow: var(--shadow-sm);
}

.group-title {
  display: block;
  padding: 32rpx 40rpx 20rpx;
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
  font-weight: 500;
}

.settings-item {
  display: flex;
  align-items: center;
  padding: 32rpx 40rpx;
  border-bottom: 1rpx solid var(--color-divider);
  position: relative;
  transition: background 0.15s ease;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item:active {
  background: #F5EDE8;
}

.item-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 40rpx;
  height: 40rpx;
  text-align: center;
  line-height: 40rpx;
  color: var(--color-primary);
  background: #FAEEE8;
  border-radius: 50%;
  font-weight: 700;
  font-family: Georgia, 'Times New Roman', serif;
  flex-shrink: 0;
}

.item-label {
  flex: 1;
  font-size: var(--font-size-lg);
  color: var(--color-text-primary);
}

.item-value {
  font-size: var(--font-size-base);
  color: var(--color-text-tertiary);
  margin-right: 16rpx;
}

.item-arrow {
  font-size: 32rpx;
  color: var(--color-border);
  font-weight: normal;
}

.item-switch {
  transform: scale(0.85);
}

.logout-section {
  padding: 40rpx 20rpx;
}

.logout-btn {
  background: var(--color-danger);
  color: #fff;
  border-radius: var(--radius-capsule);
  height: 90rpx;
  line-height: 90rpx;
  font-size: var(--font-size-xl);
  font-weight: 500;
}

.logout-btn:active {
  opacity: 0.9;
}

.logout-btn::after {
  display: none;
}
