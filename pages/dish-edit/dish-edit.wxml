<!--pages/dish-edit/dish-edit.wxml-->
<wxs module="helpers" src="../../utils/wxs/helpers.wxs"></wxs>
<view class="container">
  <form bindsubmit="submitForm">
    <!-- 图片上传 -->
    <view class="section card">
      <view class="section-title">菜品图片（1-3张）</view>
      <view class="image-uploader">
        <block wx:for="{{dish.images}}" wx:key="index">
          <view class="image-preview">
            <image src="{{item}}" class="preview-image" mode="aspectFill"></image>
            <view class="image-remove" bindtap="removeImage" data-index="{{index}}">
              <text class="image-remove-text">✕</text>
            </view>
          </view>
        </block>
        
        <view wx:if="{{dish.images.length < 3}}" class="image-upload-btn" bindtap="chooseImage">
          <text class="upload-icon">📷</text>
          <text class="upload-text">添加图片</text>
        </view>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="section card">
      <view class="section-title">基本信息</view>
      
      <view class="form-group">
        <view class="form-label">菜品名称*</view>
        <input 
          name="name" 
          value="{{dish.name}}" 
          placeholder="请输入菜品名称（支持emoji）" 
          class="form-input"
          maxlength="20"
        />
      </view>

      <view class="form-group">
        <view class="form-label">菜品描述</view>
        <textarea 
          name="description" 
          value="{{dish.description}}" 
          placeholder="简单描述一下这道菜（可选）" 
          class="form-textarea"
          maxlength="100"
        />
      </view>
    </view>

    <!-- 分类信息 -->
    <view class="section card">
      <view class="section-title">分类信息</view>
      
      <view class="form-group">
        <view class="form-label">烹饪时间</view>
        <picker 
          name="cookingTime" 
          value="{{cookingTimeIndex}}" 
          range="{{cookingTimeOptions}}"
          bindchange="onCookingTimeChange"
        >
          <view class="picker {{dish.cookingTime ? '' : 'placeholder'}}">
            {{dish.cookingTime || '请选择烹饪时间'}}
          </view>
        </picker>
      </view>

      <view class="form-group">
        <view class="form-label">难度</view>
        <picker 
          name="difficulty" 
          value="{{difficultyIndex}}" 
          range="{{difficultyOptions}}"
          bindchange="onDifficultyChange"
        >
          <view class="picker {{dish.difficulty ? '' : 'placeholder'}}">
            {{dish.difficulty || '请选择难度'}}
          </view>
        </picker>
      </view>

      <view class="form-group">
        <view class="form-label">菜系</view>
        <picker 
          name="cuisineType" 
          value="{{cuisineTypeIndex}}" 
          range="{{cuisineTypeOptions}}"
          bindchange="onCuisineTypeChange"
        >
          <view class="picker {{dish.cuisineType ? '' : 'placeholder'}}">
            {{dish.cuisineType || '请选择菜系'}}
          </view>
        </picker>
      </view>
    </view>

    <!-- 标签信息 -->
    <view class="section card">
      <view class="section-title">标签信息</view>
      
      <view class="form-group">
        <view class="form-label">用餐场景</view>
        <view class="tag-selector">
          <view 
            wx:for="{{mealTimeOptions}}" 
            wx:key="value"
            class="tag {{helpers.includes(dish.mealTime, item.value) ? 'active' : ''}}"
            bindtap="toggleMealTime"
            data-value="{{item.value}}"
          >
            {{item.label}}
          </view>
        </view>
      </view>

      <view class="form-group">
        <view class="form-label">食材标签</view>
        <view class="ingredients-input">
          <input 
            value="{{newIngredient}}" 
            placeholder="输入食材后按回车添加" 
            class="ingredient-input"
            bindinput="onIngredientInput"
            bindconfirm="addIngredient"
          />
          <button class="btn-secondary btn-small" bindtap="addIngredient">添加</button>
        </view>
        <view class="ingredients-tags">
          <view 
            wx:for="{{dish.ingredients}}" 
            wx:key="index"
            class="tag tag-primary"
          >
            {{item}}
            <view class="tag-remove" bindtap="removeIngredient" data-index="{{index}}">
              ×
            </view>
          </view>
        </view>
      </view>

      <view class="form-group">
        <view class="form-label">喜爱程度</view>
        <view class="star-rating">
          <text 
            wx:for="{{[1,2,3,4,5]}}" 
            wx:key="index"
            class="star {{index < dish.starRating ? 'active' : ''}}"
            bindtap="setStarRating"
            data-rating="{{index + 1}}"
          >
            ★
          </text>
        </view>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <button form-type="submit" class="btn-primary btn-large">
        {{mode === 'add' ? '添加菜品' : '保存修改'}}
      </button>
      
      <button 
        wx:if="{{mode === 'edit'}}" 
        class="btn-danger btn-medium" 
        bindtap="showDeleteConfirm"
      >
        删除菜品
      </button>
    </view>
  </form>

  <!-- 删除确认弹窗 -->
  <view class="delete-dialog" wx:if="{{showDeleteDialog}}">
    <view class="dialog-mask" bindtap="hideDeleteDialog"></view>
    <view class="dialog-content">
      <view class="dialog-title">确认删除</view>
      <view class="dialog-message">确定要删除"{{dish.name}}"吗？此操作不可恢复。</view>
      <view class="dialog-buttons">
        <button class="btn-secondary" bindtap="hideDeleteDialog">取消</button>
        <button class="btn-primary" bindtap="confirmDelete">确认删除</button>
      </view>
    </view>
  </view>
</view>