<!--index.wxml-->
<view>
  <!-- 水彩背景层 -->
  <view class="watercolor-bg"></view>

  <!-- 主内容容器 -->
  <view class="container">

    <!-- 搜索栏 - 有机圆润形态 -->
    <view class="search-bar">
      <view class="search-input">
        <view class="search-icon-box">
          <image class="search-icon-img" src="/images/home.png" mode="aspectFit"></image>
        </view>
        <input 
          placeholder="搜索菜名或食材" 
          bindinput="onSearchInput" 
          value="{{searchKeyword}}"
          class="search-input-field"
        />
        <view wx:if="{{searchKeyword}}" class="clear-btn" bindtap="clearSearch">
          <text class="clear-icon">X</text>
        </view>
      </view>
    </view>

    <!-- 分类筛选栏 - 有机胶囊形态 -->
    <view class="filter-bar">
      <view 
        class="filter-tag {{activeFilter === 'all' ? 'active' : ''}}" 
        bindtap="setFilter"
        data-filter="all"
      >全部</view>
      <view 
        class="filter-tag {{activeFilter === 'breakfast' ? 'active' : ''}}" 
        bindtap="setFilter"
        data-filter="breakfast"
      >早餐</view>
      <view 
        class="filter-tag {{activeFilter === 'lunch' ? 'active' : ''}}" 
        bindtap="setFilter"
        data-filter="lunch"
      >午餐</view>
      <view 
        class="filter-tag {{activeFilter === 'dinner' ? 'active' : ''}}" 
        bindtap="setFilter"
        data-filter="dinner"
      >晚餐</view>
      <view 
        class="filter-tag {{activeFilter === 'favorite' ? 'active' : ''}}" 
        bindtap="setFilter"
        data-filter="favorite"
      >最爱</view>
    </view>

    <!-- 菜品网格 - 不对称有机布局 -->
    <view class="dishes-grid">
      <block wx:for="{{filteredDishes}}" wx:key="id">
        <view class="dish-card {{(index % 3 === 0) ? 'dish-card-wide' : ''}}" bindtap="viewDishDetail" data-dish="{{item}}">
          <image class="dish-image" src="{{item.images[0]}}" mode="aspectFill" lazy-load="true"></image>
          <view class="dish-card-content">
            <view class="dish-name">{{item.name}}</view>
            <view wx:if="{{item.cuisineType}}" class="dish-cuisine">{{item.cuisineType}}</view>
          </view>
        </view>
      </block>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{filteredDishes.length === 0 && !isLoading}}" class="empty-state">
      <view class="empty-icon-circle" bindtap="addDish">
        <text class="empty-icon-text">+</text>
      </view>
      <view class="empty-text">暂无菜品</view>
      <view class="empty-subtext">点击下方按钮添加第一个菜品吧</view>
    </view>

    <!-- 底部操作区：浮动有机形态 -->
    <view class="bottom-action-bar">
      <button class="btn-random {{isSpinning ? 'spinning' : ''}}" bindtap="randomDish">
        <text class="btn-random-text">随机选菜</text>
      </button>
      <button class="btn-add" bindtap="addDish">
        <text class="btn-add-text">+</text>
      </button>
    </view>

  </view>
</view>