/* ==================== 首页 - 有机自然美食风 v2.0 ==================== */

/* 页面容器 */
.container {
  position: relative;
  padding: 24rpx 28rpx calc(180rpx + constant(safe-area-inset-bottom));
  padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

/* ====== 搜索栏 - 有机圆润形态 ====== */
.search-bar {
  width: 100%;
  margin-bottom: 28rpx;
  animation: fadeIn 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.search-input {
  width: 100%;
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: 50rpx;
  padding: 16rpx 24rpx;
  box-shadow: var(--shadow-sm);
  border: 2rpx solid transparent;
  transition: all 0.25s ease;
}

.search-input:focus-within {
  border-color: var(--color-primary-light);
  box-shadow: 0 0 0 4rpx rgba(212, 115, 94, 0.08), var(--shadow-md);
}

.search-icon-box {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #F5EDE8;
  border-radius: 20rpx;
}

.search-icon-text {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-primary);
  font-family: 'Georgia', serif;
  letter-spacing: 0.5rpx;
}

.search-input-field {
  flex: 1;
  font-size: 28rpx;
  height: 44rpx;
  color: var(--color-text-primary);
}

.search-input-field::placeholder {
  color: var(--color-text-placeholder);
}

.clear-btn {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.35;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #F0EAE5;
  border-radius: 50%;
}

.clear-icon {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  font-weight: 600;
}

/* ====== 分类筛选栏 - 有机胶囊形态 ====== */
.filter-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 32rpx;
  gap: 12rpx;
  animation: fadeIn 0.5s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.filter-tag {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 6rpx;
  background: var(--color-bg-card);
  border-radius: 50rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  white-space: nowrap;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.filter-tag:active {
  transform: scale(0.95);
}

.filter-tag.active {
  background: var(--color-primary-gradient);
  color: #fff;
  border-color: var(--color-primary);
  box-shadow: var(--shadow-warm);
  font-weight: 600;
}

/* ====== 菜品网格 - 不对称有机布局 ====== */
.dishes-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 32rpx;
  animation: fadeIn 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

.dish-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  transition: all 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  position: relative;
}

.dish-card:active {
  transform: scale(0.96);
  box-shadow: var(--shadow-md);
}

/* 不对称布局：第3个卡片跨列（如果在范围内） */
.dish-card-wide {
  grid-column: 1 / -1;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.dish-card-wide .dish-image {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.dish-card-wide .dish-card-content {
  flex: 1;
  padding: 24rpx;
}

.dish-image {
  width: 100%;
  height: 280rpx;
  background: #F5EDE8;
  display: block;
  transition: transform 0.3s ease;
}

.dish-card:active .dish-image {
  transform: scale(1.05);
}

.dish-card-content {
  padding: 18rpx 16rpx 22rpx;
}

.dish-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.4;
}

.dish-cuisine {
  font-size: var(--font-size-xs);
  color: var(--color-text-tertiary);
  margin-top: 6rpx;
  display: inline-block;
  padding: 2rpx 12rpx;
  background: #F5EDE8;
  border-radius: 16rpx;
}

/* ====== 空状态 ====== */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  animation: fadeIn 0.5s ease;
}

.empty-icon-circle {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #F5EDE8;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
  box-shadow: var(--shadow-sm);
}

.empty-icon-text {
  font-size: 56rpx;
  color: var(--color-primary-light);
  font-weight: 300;
  font-family: 'Georgia', serif;
}

.empty-text {
  font-size: var(--font-size-xl);
  color: var(--color-text-tertiary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.empty-subtext {
  font-size: var(--font-size-md);
  color: var(--color-text-placeholder);
}

/* ====== 底部操作区 - 浮动有机形态 ====== */
.bottom-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0 20rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding-bottom: calc(20rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(253, 248, 243, 0.95) 60%, transparent);
  z-index: 99;
}

/* 随机选菜按钮 - 左侧大胶囊 */
.btn-random {
  flex: 1;
  margin: 0 20rpx 0 28rpx;
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-gradient);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  box-shadow: var(--shadow-warm);
  border: none !important;
  line-height: 1.3;
  position: relative;
  overflow: hidden;
}

.btn-random::before {
  content: '';
  position: absolute;
  top: 0;
  left: -50%;
  width: 50%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.15), transparent);
  transform: skewX(-25deg);
  animation: shimmer 3s ease-in-out infinite;
}

.btn-random::after {
  display: none;
}

.btn-random:active {
  opacity: 0.92;
  transform: scale(0.97);
}

.btn-random.spinning {
  animation: pulse 0.6s ease infinite;
}

@keyframes pulse {
  0% { box-shadow: 0 6rpx 24rpx rgba(212, 115, 94, 0.35); }
  50% { box-shadow: 0 6rpx 40rpx rgba(212, 115, 94, 0.55); }
  100% { box-shadow: 0 6rpx 24rpx rgba(212, 115, 94, 0.35); }
}

/* 添加按钮 - 右侧圆形 */
.btn-add {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: var(--color-bg-card);
  margin-right: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(61, 44, 42, 0.12), 0 0 0 3rpx rgba(212, 115, 94, 0.35);
  color: var(--color-primary);
  border: none !important;
  padding: 0;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.btn-add:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 12rpx rgba(61, 44, 42, 0.08), 0 0 0 3rpx rgba(212, 115, 94, 0.25);
}

.btn-add::after {
  display: none;
}

.btn-add-text {
  font-size: 48rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

/* 延迟动画入场 */
.dish-card:nth-child(1) { animation: fadeIn 0.4s ease; }
.dish-card:nth-child(2) { animation: fadeIn 0.5s ease; }
.dish-card:nth-child(3) { animation: fadeIn 0.6s ease; }
.dish-card:nth-child(4) { animation: fadeIn 0.7s ease; }
.dish-card:nth-child(5) { animation: fadeIn 0.8s ease; }
.dish-card:nth-child(6) { animation: fadeIn 0.9s ease; }