/* ==================== 首页 - 温暖水彩美食风（对照设计稿） ==================== */

/* 水彩背景层 */
.watercolor-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  background:
    radial-gradient(ellipse at 10% 15%, rgba(240, 160, 96, 0.18) 0%, transparent 50%),
    radial-gradient(ellipse at 90% 20%, rgba(232, 152, 108, 0.12) 0%, transparent 45%),
    radial-gradient(ellipse at 25% 75%, rgba(255, 222, 185, 0.2) 0%, transparent 55%),
    radial-gradient(ellipse at 80% 70%, rgba(240, 160, 96, 0.08) 0%, transparent 40%),
    linear-gradient(180deg, #FFF8F0 0%, #FFFAF5 40%, #FFF5EE 100%);
  pointer-events: none;
}

/* 页面容器 */
.container {
  position: relative;
  padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

/* ====== 搜索栏 - 撑满整行 ====== */
.search-bar {
  width: 100%;
  margin-bottom: 24rpx;
}

.search-input {
  width: 100%;
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: 50rpx;
  padding: 18rpx 28rpx;
  box-shadow: var(--shadow-sm);
}

.search-icon {
  font-size: 34rpx;
  margin-right: 16rpx;
  opacity: 0.45;
  flex-shrink: 0;
}

.search-input-field {
  flex: 1;
  font-size: 30rpx;
  height: 44rpx;
  color: var(--color-text-primary);
}

.search-input-field::placeholder {
  color: var(--color-text-placeholder);
}

.clear-btn {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.3;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.clear-icon {
  font-size: 28rpx;
  color: #999;
}

/* ====== 分类筛选栏 - 均匀分布撑满整行 ====== */
.filter-bar {
  display: flex;
  justify-content: space-between;
  margin-bottom: 28rpx;
  gap: 14rpx;
}

.filter-tag {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 6rpx;
  background: var(--color-bg-card);
  border-radius: 50rpx;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  border: 2rpx solid transparent;
  box-shadow: var(--shadow-sm);
  transition: all 0.25s ease;
  white-space: nowrap;
  text-align: center;
}

.filter-tag.active {
  background: var(--color-primary-gradient);
  color: #fff;
  border-color: var(--color-primary);
  box-shadow: 0 4rpx 16rpx rgba(232, 152, 108, 0.3);
}

/* ====== 菜品网格 - 仅图片+名称 ====== */
.dishes-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 22rpx;
  margin-bottom: 32rpx;
}

.dish-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  overflow: hidden;
  box-shadow: var(--shadow-md);
  transition: all 0.25s ease;
}

.dish-card:active {
  transform: scale(0.97);
  box-shadow: var(--shadow-sm);
}

.dish-image {
  width: 100%;
  height: 280rpx;
  background: #FDF6EF;
  display: block;
}

.dish-name {
  text-align: center;
  padding: 20rpx 12rpx 26rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  line-height: 1.3;
}

/* ====== 空状态 ====== */
.empty-state {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  opacity: 0.3;
  margin-bottom: 36rpx;
  display: block;
}

.empty-text {
  font-size: var(--font-size-xl);
  color: var(--color-text-tertiary);
  margin-bottom: 12rpx;
  font-weight: 500;
}

.empty-subtext {
  font-size: var(--font-size-md);
  color: var(--color-text-placeholder);
}

/* ====== 底部操作区 - 同一行：随机选菜(左) + 添加(右) ====== */
.bottom-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0 20rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, rgba(255, 248, 240, 0.95) 70%, transparent);
  z-index: 99;
}

/* 随机选菜按钮 - 左侧大胶囊 */
.btn-random {
  flex: 1;
  margin: 0 24rpx 0 32rpx;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-primary-gradient);
  color: #fff;
  border-radius: 50rpx;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 6rpx;
  box-shadow: 0 6rpx 24rpx rgba(232, 152, 108, 0.35);
  border: none !important;
  line-height: 1.3;
}

.btn-random::after {
  display: none;
}

.btn-random:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-random.spinning {
  animation: pulse 0.6s ease infinite;
}

@keyframes pulse {
  0% { box-shadow: 0 6rpx 24rpx rgba(232, 152, 108, 0.35); }
  50% { box-shadow: 0 6rpx 36rpx rgba(232, 152, 108, 0.55); }
  100% { box-shadow: 0 6rpx 24rpx rgba(232, 152, 108, 0.35); }
}

/* 添加按钮 - 右侧胶囊形（与随机选菜同形状） */
.btn-add {
  width: 104rpx;
  height: 88rpx;
  border-radius: 50rpx;
  background: var(--color-bg-card);
  margin-right: 32rpx;
  font-size: 40rpx;
  line-height: 84rpx;
  text-align: center;
  box-shadow: 0 6rpx 24rpx rgba(93, 78, 62, 0.15), 0 0 0 3rpx rgba(232, 152, 108, 0.4);
  color: var(--color-primary);
  font-weight: 300;
  border: none !important;
  padding: 0;
  flex-shrink: 0;
}

.btn-add::after {
  display: none;
}

.btn-add:active {
  transform: scale(0.92);
  box-shadow: 0 4rpx 16rpx rgba(93, 78, 62, 0.1), 0 0 0 3rpx rgba(232, 152, 108, 0.3);
}
