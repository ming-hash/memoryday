/* ==================== 全局设计令牌 - 有机自然美食风 v2.0 ==================== */
page {
  /* 基础背景 */
  background-color: #FDF8F3;
  font-family: 'PingFang SC', 'Noto Sans SC', sans-serif;
  color: #3D2C2A;

  /* 安全区域 - 适配刘海屏/全面屏 */
  --safe-area-bottom: 0px;
  --safe-area-bottom: constant(safe-area-inset-bottom);
  --safe-area-bottom: env(safe-area-inset-bottom);

  /* 主色调 - 暖陶土红（有机自然感） */
  --color-primary: #D4735E;
  --color-primary-light: #E8997A;
  --color-primary-dark: #B85A48;
  --color-primary-gradient: linear-gradient(145deg, #E8997A 0%, #D4735E 100%);

  /* 背景色 - 有机奶油白 */
  --color-bg-page: #FDF8F3;
  --color-bg-card: #FFFFFF;
  --color-bg-mask: rgba(61, 44, 42, 0.5);

  /* 文字色 - 深咖啡棕系 */
  --color-text-primary: #3D2C2A;
  --color-text-secondary: #7A6B65;
  --color-text-tertiary: #A89B94;
  --color-text-placeholder: #C4B8B0;

  /* 边框和分隔线 */
  --color-border: #E8DDD5;
  --color-divider: #F0EAE5;

  /* 功能色 - 保留必要语义色 */
  --color-danger: #D4605A;
  --color-success: #5A8A6A;
  --color-warning: #E8A55A;
  --color-info: #5A8AE8;

  /* 圆角规范 - 有机变化 */
  --radius-sm: 10rpx;
  --radius-md: 14rpx;
  --radius-lg: 18rpx;
  --radius-xl: 24rpx;
  --radius-capsule: 50rpx;

  /* 阴影规范 - 自然层次 */
  --shadow-sm: 0 2rpx 10rpx rgba(61, 44, 42, 0.06);
  --shadow-md: 0 4rpx 20rpx rgba(61, 44, 42, 0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(61, 44, 42, 0.1);
  --shadow-warm: 0 6rpx 24rpx rgba(212, 115, 94, 0.2);

  /* 字体规范 */
  --font-size-xs: 22rpx;
  --font-size-sm: 24rpx;
  --font-size-md: 26rpx;
  --font-size-base: 28rpx;
  --font-size-lg: 30rpx;
  --font-size-xl: 32rpx;
  --font-size-xxl: 36rpx;
  --font-size-display: 42rpx;
}

/* ==================== 通用容器 ==================== */
.container {
  padding: 24rpx 28rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

/* 卡片样式 - 有机圆角变化 */
.card {
  background: var(--color-bg-card);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
  overflow: hidden;
  position: relative;
}

/* 按钮样式 */
.btn-primary {
  background: var(--color-primary-gradient);
  color: white;
  border: none;
  border-radius: var(--radius-capsule);
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(212, 115, 94, 0.25);
  transition: all 0.2s ease;
}

.btn-primary:active {
  transform: scale(0.97);
  box-shadow: 0 2rpx 8rpx rgba(212, 115, 94, 0.2);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: var(--color-bg-card);
  color: var(--color-text-primary);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-capsule);
  font-weight: 500;
  transition: all 0.2s ease;
}

.btn-secondary:active {
  background: #F5EDE8;
  border-color: var(--color-primary-light);
}

/* 标签样式 - 有机圆润 */
.tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 24rpx;
  font-size: var(--font-size-xs);
  margin-right: 10rpx;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.tag-primary {
  background: #FAEEE8;
  color: var(--color-primary);
}

.tag-success {
  background: #EDF5EE;
  color: var(--color-success);
}

.tag-warning {
  background: #FDF3E8;
  color: var(--color-warning);
}

.tag-danger {
  background: #FCEDEB;
  color: var(--color-danger);
}

/* 文本样式 */
.text-center {
  text-align: center;
}

.text-bold {
  font-weight: 600;
}

.text-muted {
  color: var(--color-text-tertiary);
}

.text-small {
  font-size: var(--font-size-sm);
}

.text-medium {
  font-size: var(--font-size-base);
}

.text-large {
  font-size: var(--font-size-xl);
}

.text-xlarge {
  font-size: var(--font-size-xxl);
}

/* 间距工具类 */
.mt-10 { margin-top: 10rpx; }
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-10 { margin-bottom: 10rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-10 { margin-left: 10rpx; }
.ml-20 { margin-left: 20rpx; }
.mr-10 { margin-right: 10rpx; }
.mr-20 { margin-right: 20rpx; }

.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }

/* 弹性布局 */
.flex {
  display: flex;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

/* 图片样式 */
.image-responsive {
  width: 100%;
  height: auto;
}

.image-round {
  border-radius: var(--radius-lg);
}

.image-circle {
  border-radius: 50%;
}

/* 输入框样式 */
.input {
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 20rpx;
  font-size: var(--font-size-base);
  background: var(--color-bg-card);
  color: var(--color-text-primary);
  transition: border-color 0.2s ease;
}

.input:focus {
  border-color: var(--color-primary);
  outline: none;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 60rpx;
}

.loading-text {
  margin-left: 20rpx;
  color: var(--color-text-tertiary);
}

/* 空状态 - 有机风格 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
  color: var(--color-text-tertiary);
}

/* 水彩纹理背景（优化版） */
.watercolor-bg {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
  background:
    radial-gradient(ellipse at 12% 20%, rgba(212, 115, 94, 0.1) 0%, transparent 50%),
    radial-gradient(ellipse at 88% 15%, rgba(232, 153, 122, 0.08) 0%, transparent 45%),
    radial-gradient(ellipse at 30% 80%, rgba(232, 168, 124, 0.12) 0%, transparent 50%),
    radial-gradient(ellipse at 75% 70%, rgba(212, 115, 94, 0.06) 0%, transparent 40%),
    radial-gradient(ellipse at 50% 40%, rgba(253, 248, 243, 0.5) 0%, transparent 60%),
    linear-gradient(180deg, #FDF8F3 0%, #FEFBF7 50%, #FDF5EF 100%);
  pointer-events: none;
}

/* 动画效果 - 自然流畅 */
.fade-in {
  animation: fadeIn 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(24rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes gentleBounce {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03); }
}

@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}

/* 骨架屏加载效果 */
.skeleton {
  background: linear-gradient(90deg, #F0EAE5 25%, #F5F0EB 50%, #F0EAE5 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: var(--radius-md);
}

/* 响应式工具类 */
@media (min-width: 768px) {
  .container {
    max-width: 750rpx;
    margin: 0 auto;
  }
}