# 腾讯云COS配置文件示例
# 请复制此文件为 .env 并根据实际配置修改

# ============ 腾讯云配置 ============
# 腾讯云账号配置
TENCENT_CLOUD_SECRET_ID=your_secret_id_here
TENCENT_CLOUD_SECRET_KEY=your_secret_key_here
TENCENT_CLOUD_APP_ID=your_app_id_here

# COS存储桶配置（开发环境）
COS_DEV_REGION=ap-beijing
COS_DEV_BUCKET=memoryday-dev-{appid}

# COS存储桶配置（生产环境）
COS_PROD_REGION=ap-beijing
COS_PROD_BUCKET=memoryday-prod-{appid}

# 小程序AppID（必填）
WECHAT_APP_ID=your_miniprogram_appid

# ============ 后端配置 ============
# Django后端配置
DJANGO_SECRET_KEY=your_django_secret_key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.ngrok.io

# 数据库配置
DATABASE_URL=postgresql://username:password@localhost:5432/memoryday

# Redis配置
REDIS_URL=redis://localhost:6379/0

# ============ 其他配置 ============
# 文件上传限制（单位：字节）
MAX_UPLOAD_SIZE=5242880

# 图片处理配置
IMAGE_THUMBNAIL_SIZE=200
IMAGE_PREVIEW_QUALITY=80

# 安全配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com