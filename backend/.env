# ============================================================
# MemoryDay Django 后端环境变量配置
# ============================================================
# 首次使用前，请按以下说明填写所有带 <your-xxx> 标记的值
# ============================================================

# --- Django 基础配置 ---
# 生成方式: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=<your-django-secret-key>

# 生产环境务必设为 False
DJANGO_DEBUG=False

# 逗号分隔的允许域名/IP，生产环境务必加入真实域名
# 示例: DJANGO_ALLOWED_HOSTS=example.com,www.example.com,123.456.789.0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,<your-server-ip>,*

# --- MySQL 数据库配置 ---
# 数据库名称可自定义，但需与 docker-compose.yml 中 MYSQL_DATABASE 保持一致
MYSQL_DATABASE=<your-db-name>

# 数据库应用用户（非 root）
MYSQL_USER=<your-db-user>

# 数据库应用用户密码（建议 16 位以上随机字符）
MYSQL_PASSWORD=<your-db-password>

# MySQL root 密码（建议 16 位以上随机字符，与上方不同）
MYSQL_ROOT_PASSWORD=<your-db-root-password>

# Docker 内服务名，如使用外部数据库则改为真实 IP
MYSQL_HOST=db
MYSQL_PORT=3306

# --- Redis 配置 ---
# Redis 密码（建议 16 位以上随机字符）
REDIS_PASSWORD=<your-redis-password>

# Docker 内服务名，如使用外部 Redis 则改为真实 IP
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# Redis 完整连接 URL（自动引用 REDIS_PASSWORD）
REDIS_URL=redis://:<your-redis-password>@redis:6379/0

# --- Celery 任务队列配置（自动引用 REDIS_PASSWORD）---
CELERY_BROKER_URL=redis://:<your-redis-password>@redis:6379/1
CELERY_RESULT_BACKEND=redis://:<your-redis-password>@redis:6379/2

# --- 微信小程序配置 ---
# 获取方式: 登录微信公众平台 https://mp.weixin.qq.com -> 开发 -> 开发管理 -> 开发设置
# AppID(小程序ID) 和 AppSecret(小程序密钥)
WECHAT_APPID=<your-wechat-appid>
WECHAT_SECRET=<your-wechat-secret>

# 微信消息推送 Token 和 AES Key（如不需要可留空）
WECHAT_TOKEN=
WECHAT_AES_KEY=

# --- 文件上传配置 ---
MAX_FILE_SIZE=104857600
MAX_STORAGE_PER_USER=10737418240
UPLOAD_DIR=uploads

# --- 腾讯云对象存储 COS 配置（可选，不用则保持 COS_ENABLED=False）---
# 获取方式: 登录腾讯云控制台 https://console.cloud.tencent.com/cam/capi -> 访问管理 -> API密钥管理
# 新建密钥获取 SecretId 和 SecretKey
COS_ENABLED=False
COS_SECRET_ID=<your-cos-secret-id>
COS_SECRET_KEY=<your-cos-secret-key>

# COS Bucket 名称（需提前在腾讯云 COS 控制台创建）
COS_BUCKET=<your-cos-bucket-name>
COS_REGION=ap-beijing

# COS 的 APPID（在腾讯云控制台 -> 账号信息中查看）
COS_APP_ID=<your-cos-app-id>

# COS 自定义域名（如已配置 CDN 加速域名，否则留空）
COS_DOMAIN=
COS_PREFIX=memoryday
COS_MAX_FILE_SIZE=5242880
COS_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp
COS_USE_SIGNED_URL=True
COS_DEFAULT_EXPIRES=3600

# --- CORS / CSRF 跨域配置 ---
# 前端访问地址，多个用逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- 日志配置 ---
LOG_LEVEL=INFO
LOG_FILE=logs/django.log

# --- 部署模式 ---
# production 或 development
DEPLOYMENT_MODE=production

# --- 认证方式开关 ---
# 生产环境建议关闭密码/短信登录，仅保留微信登录
# 如需要密码登录，请设为 False
DISABLE_PASSWORD_LOGIN=True
DISABLE_SMS_LOGIN=True