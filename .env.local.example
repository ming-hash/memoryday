# MemoryDay 本地部署环境配置示例
# 复制此文件为 .env.local 并修改相应配置

# 数据库配置
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=memoryday
MYSQL_USER=memoryday_user
MYSQL_PASSWORD=memoryday_password

# 部署模式
DEPLOYMENT_MODE=local

# 本地开发配置
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=your-local-secret-key-here

# 微信小程序配置（本地测试）
WECHAT_APPID=wxbe5cb0f551d030e5
WECHAT_SECRET=d5eb987861b015a2d07fc385bbcf5c0b

# 文件存储配置（本地）
COS_ENABLED=False
UPLOAD_DIR=uploads
MAX_FILE_SIZE=104857600

# 本地开发服务器配置
BACKEND_HOST=localhost
BACKEND_PORT=8000

# 数据库连接配置
DB_HOST=localhost
DB_PORT=3306

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379